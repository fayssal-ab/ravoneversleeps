# ─────────────────────────────────────────────────────────────────────────
# RAVONEVERSLEEPS — environment
# Copy to .env.local and fill in. .env.local is gitignored. Never put secrets
# in NEXT_PUBLIC_* — those are inlined into the browser bundle.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ravo
# Managed hosts requiring TLS (e.g. Aiven): base64 of the CA PEM. Leave unset locally.
DB_SSL_CA_BASE64=

# ── Secrets ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-change-me
# 32+ random bytes; signs the OAuth flow cookie. `openssl rand -hex 32`
SESSION_SECRET=dev-session-secret-change-me-0000000000000000000000000000000000

# ── Public casino branding (safe to expose) ──
NEXT_PUBLIC_QZINO_CODE=RAVO50
NEXT_PUBLIC_QZINO_URL=https://qzino-partners.com/trdj40jfb
NEXT_PUBLIC_KICK_CHANNEL=ravoneversleeps
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/GKjE3sUFz3
NEXT_PUBLIC_X_URL=https://x.com/ravoneversleeps
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Viewer sign-in (optional; buttons hide themselves when unset) ──
# Kick app: kick.com/settings/developer → redirect <site>/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=
# Discord app: discord.com/developers/applications → redirect <site>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Kick chatroom id for the tournament !join reader (kick.com/api/v2/channels/<slug> → chatroom.id)
KICK_CHATROOM_ID=36339542
# Slot catalogue feed (names, providers, art)
SLOTS_FEED_URL=https://api.sharkz.gg/api/slots
# Bearer secret for /api/cron/* (leaderboard sync every 6 hours and daily slot sync)
CRON_SECRET=

# Discord bot (tickets for Qzino verification and challenge claims). Same app
# as DISCORD_CLIENT_ID; the bot must be in the server (see README).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_STAFF_ROLE_ID=
